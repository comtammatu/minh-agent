{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.test.ts",
    "test/**/*.ts",
    "dashboard/src/**/*.vitest.tsx"
  ],
  "project": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "dashboard/src/**/*.ts",
    "dashboard/src/**/*.tsx"
  ],
  "ignore": ["scripts/**", "docs/**", ".claude/**"],
  "ignoreDependencies": ["@testing-library/*", "tailwindcss"]
}
