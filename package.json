{
  "name": "minh-agent",
  "version": "2.0.0",
  "description": "Minh (明) — Greenfield Trading Runtime (TUI + Telegram)",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:run": "bun test --run",
    "test:execution-contract": "bun test --run test/execution",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "biome check . || echo 'LINT-BASELINE-NONZERO (see CONTRIBUTING + quality-gates)'",
    "lint:fix": "biome check . --write || true",
    "deadcode": "knip || echo 'DEADCODE-BASELINE (see knip output + CONTRIBUTING)'",
    "bench:pipeline": "LOG_LEVEL=ERROR bun run scripts/backtest/run-pipeline-benchmark.ts",
    "bench:pipeline:ci": "LOG_LEVEL=ERROR bun run scripts/check-pipeline-performance.ts"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "^0.32.2",
    "bybit-api": "^4.6.1",
    "ink": "^6.8.0",
    "postgres": "^3.4.8",
    "react": "^19.2.5",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "1.3.14",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "knip": "^6.15.0",
    "typescript": "~7.0.2"
  }
}
