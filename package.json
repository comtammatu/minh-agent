{
  "name": "minh-agent",
  "version": "2.0.0",
  "description": "Minh (明) — Autonomous Trading Runtime",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "test:run": "bun test --run && bun run dashboard:test",
    "test:execution-contract": "bun test --run test/execution",
    "typecheck": "bunx tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "biome check . || echo 'LINT-BASELINE-NONZERO (S3/S4 recorded; justified in research/backtest + recovery paths; see task-contract + PR)'",
    "lint:fix": "biome check . --write || true",
    "deadcode": "knip || echo 'DEADCODE-BASELINE (see knip output + task contract S3/S4)'",
    "dashboard:prepare-tv": "bun run scripts/prepare-tradingview-assets.ts",
    "dashboard:dev": "bun run dashboard:prepare-tv && vite --config dashboard/vite.config.ts",
    "dashboard:build": "bun run dashboard:prepare-tv && vite build --config dashboard/vite.config.ts",
    "dashboard:typecheck": "bunx tsc --noEmit -p dashboard/tsconfig.json",
    "dashboard:test": "bunx vitest run --config dashboard/vitest.config.ts",
    "fixtures": "bun run scripts/gen-fixtures.ts",
    "bench:pipeline": "LOG_LEVEL=ERROR bun run src/backtest/run-pipeline-benchmark.ts",
    "bench:pipeline:ci": "LOG_LEVEL=ERROR bun run scripts/check-pipeline-performance.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.8",
    "@nktkas/hyperliquid": "^0.32.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bybit-api": "^4.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ink": "^6.8.0",
    "lucide-react": "^1.8.0",
    "postgres": "^3.4.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "knip": "^6.15.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
