# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://minh:minh_dev@localhost:5432/minh

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Telegram alerts (optional — alerts disabled if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hyperliquid wallet private key for signing transactions (0x-prefixed hex, NEVER commit)
PRIVATE_KEY=

# Elysia HTTP server bearer auth token (optional)
MINH_API_TOKEN=

# Paper trade mode: simulate fills, no real exchange calls (default: false)
PAPER_TRADE=true

# Paper trade slippage (optional, default 0.05% = 0.0005)
# PAPER_SLIPPAGE_PCT=0.0005