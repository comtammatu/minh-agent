# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://minh:minh_dev@localhost:5432/minh

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Risk per position: fraction of account equity at risk per trade (default 0.02 = 2%)
# RISK_PER_POSITION=0.02

# Telegram alerts (optional — alerts disabled if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Đầu/cuối ngày reports: IANA TZ for journal day boundaries (default UTC). Example: Asia/Ho_Chi_Minh
TELEGRAM_REPORT_TZ=UTC
# Set to false to disable scheduled morning/evening summaries
TELEGRAM_DAY_REPORTS=true

# Hyperliquid private key for signing (0x-prefixed hex, NEVER commit)
# Recommended: use an agent wallet PK (can trade but cannot withdraw)
PRIVATE_KEY=

# Main account address for info queries (balance, positions).
# Required when PRIVATE_KEY is an agent wallet. Omit if using main wallet PK directly.
ACCOUNT_ADDRESS=

# --- Multi-account (3 strategies) — pick ONE of: flat env vars OR STRATEGY_WALLETS JSON ---
#
# ExchangePool: each strategy uses its own agent key + main address.
# If all configured strategy pairs are set, PRIVATE_KEY/ACCOUNT_ADDRESS below are optional
# (shared fallback reuses layered, then quant, then smc-sd). Set PRIVATE_KEY to override
# that fallback or match older docs (same as layered).
#
# (A) Flat (easiest) — agent PK + main address per strategy; omit a pair to skip that strategy
PRIVATE_KEY_LAYERED=
ACCOUNT_ADDRESS_LAYERED=
PRIVATE_KEY_QUANT=
ACCOUNT_ADDRESS_QUANT=
PRIVATE_KEY_SMC_SD=
ACCOUNT_ADDRESS_SMC_SD=
#
# (B) One-line JSON — if STRATEGY_WALLETS is non-empty, flat vars above are ignored
# STRATEGY_WALLETS={"layered":{"privateKey":"0x...","accountAddress":"0x..."},...}
#
# PRIVATE_KEY=   # optional when PRIVATE_KEY_LAYERED + ACCOUNT_ADDRESS_LAYERED (and other pairs) are all set
# ACCOUNT_ADDRESS=
#
STRATEGY_WALLETS=

# Paper trade mode: simulate fills, no real exchange calls (default: false)
PAPER_TRADE=true

# Paper: separate starting balance per strategy wallet (USD), mirrors 3-wallet live.
# Omit → $100 each (see PAPER_DEFAULT_BALANCE_PER_WALLET in config.ts).
# PAPER_BALANCE_LAYERED=100
# PAPER_BALANCE_QUANT=100
# PAPER_BALANCE_SMC_SD=100

# Paper trade slippage (optional, default 0.05% = 0.0005)
# PAPER_SLIPPAGE_PCT=0.0005

# ── Active Exchange ────────────────────────────────────────────────────────────
# Which exchange this process trades on. REQUIRED — startup fails if not set.
# Only one exchange active per process.
ACTIVE_EXCHANGE=HL

# ── Bybit (ACTIVE_EXCHANGE=BB) ─────────────────────────────────────────────────
# Single-account: one API key pair used for all strategies
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Use Bybit testnet (optional, default false)
# BYBIT_TESTNET=false

# Multi-account: per-strategy API key pairs (overrides BYBIT_API_KEY/BYBIT_API_SECRET)
# Format: "strategyId:apiKey:apiSecret,strategyId2:apiKey2:apiSecret2"
# Secret may contain colons — everything after the second colon is treated as the secret.
# BYBIT_STRATEGY_KEYS=layered:your_api_key:your_api_secret,quant:key2:secret2