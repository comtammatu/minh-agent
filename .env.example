# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://minh:minh_dev@localhost:5432/minh

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Active exchange for this process. Required: HL or BB.
ACTIVE_EXCHANGE=HL

# Hyperliquid live trading
PRIVATE_KEY=
ACCOUNT_ADDRESS=

# Bybit live trading (required only when ACTIVE_EXCHANGE=BB)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# BYBIT_TESTNET=false

# Telegram alerts (optional — alerts disabled if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_TZ=UTC
TELEGRAM_DAY_REPORTS=true

# Risk per position: fraction of account equity at risk per trade (default 0.02 = 2%)
# RISK_PER_POSITION=0.02

# Strategy selection (optional). Default: smc-sd
# ENABLED_STRATEGIES=smc-sd

# Paper trade mode: simulate fills, no real exchange calls
PAPER_TRADE=true

# Paper wallet balance per strategy (USD)
# PAPER_BALANCE_SMC_SD=100

# Paper trade slippage (optional, default 0.05% = 0.0005)
# PAPER_SLIPPAGE_PCT=0.0005
