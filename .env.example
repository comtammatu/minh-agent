# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://minh:minh_dev@localhost:5432/minh

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Telegram alerts (optional — alerts disabled if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hyperliquid private key for signing (0x-prefixed hex, NEVER commit)
# Recommended: use an agent wallet PK (can trade but cannot withdraw)
PRIVATE_KEY=

# Main account address for info queries (balance, positions).
# Required when PRIVATE_KEY is an agent wallet. Omit if using main wallet PK directly.
ACCOUNT_ADDRESS=

# Paper trade mode: simulate fills, no real exchange calls (default: false)
PAPER_TRADE=true

# Paper trade slippage (optional, default 0.05% = 0.0005)
# PAPER_SLIPPAGE_PCT=0.0005