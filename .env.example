# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://minh:minh_dev@localhost:5432/minh

# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Active exchange for this process. Required: HL or BB.
ACTIVE_EXCHANGE=HL

# Hyperliquid live trading
PRIVATE_KEY=
ACCOUNT_ADDRESS=

# Paper-trade mode (safe default). Set PAPER_TRADE=false to enable real-money
# execution paths — including arming the HL native dead-man-switch.
PAPER_TRADE=true

# Bybit live trading (required only when ACTIVE_EXCHANGE=BB)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# BYBIT_DEMO=false

# Bybit external dead-man-switch (heartbeat watchdog).
# Active only when ACTIVE_EXCHANGE=BB AND PAPER_TRADE=false.
# Run the watchdog as a separate process: bun run scripts/bb-watchdog.ts
# See docs/operations/dead-man-switch.md for deploy guide.
# BB_HEARTBEAT_PATH=/tmp/minh-heartbeat.json
# BB_HEARTBEAT_WRITE_MS=30000
# BB_HEARTBEAT_THRESHOLD_MS=300000

# Telegram alerts (optional — alerts disabled if not set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_TZ=UTC
TELEGRAM_DAY_REPORTS=true

# Risk per position: fraction of account equity at risk per trade (default 0.02 = 2%)
# RISK_PER_POSITION=0.02

# Strategy selection (optional). Default: smc-sd
# ENABLED_STRATEGIES=smc-sd

# Local dashboard (read-only, localhost-only)
DASHBOARD_PORT=3030
# TRADINGVIEW_LIBRARY_PATH=/Users/luongthebinh/Downloads/Personal/charting_library-29.4.0
